# Supabase — copy to .env and fill in from your Supabase project settings
# (Project Settings → API). Both values are client-safe: the anon key is a
# public credential gated server-side by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API origin (e.g. http://192.168.0.58:3000 for a local backend, or
# the dev-server URL once one exists). Leave blank to run against in-code
# mocks. Also used by `npm run api:pull` to refresh docs/api/openapi.json
# from <origin>/docs/json.
EXPO_PUBLIC_API_BASE_URL=
# Force mock mode even when a base URL is set. Kept on until the real API
# client layer (src/shared/api/client.ts) exists — the app code is still
# mock-only even though the backend is reachable.
EXPO_PUBLIC_USE_MOCK_API=
